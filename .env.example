# ==============================================================================
# SponsorFlow: Environment Variables Configuration
# Copy this file to .env.local and fill in your actual credentials
# ==============================================================================

# 1. Supabase Connection (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Database Direct Connection String
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# 2. JWT Secret (Required for Session Signing — must be 32+ chars in production)
JWT_SECRET=sponsorflow-super-secure-jwt-secret-key-32charsmin

# 3. Anthropic Claude API (Required for Email Generation — Prompt 7)
ANTHROPIC_API_KEY=sk-ant-api03-...

# 4. Google OAuth & Gmail API (Required for Google Sign-In — Prompt 4)
#
# Setup steps:
#   1. Go to https://console.cloud.google.com
#   2. Create a new project (or select existing)
#   3. Go to APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#   4. Application type: Web application
#   5. Add Authorized redirect URIs:
#        http://localhost:3000/api/auth/google-callback        (dev)
#        https://app.sponsorflow.com/api/auth/google-callback  (prod)
#   6. Copy Client ID and Client Secret below
#   7. Enable: Google+ API, Gmail API
#
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google-callback

# 5. Gmail Webhook & Cloud Pub/Sub (Required for Prompt 11 — Gmail Reply Tracking)
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-replies
GMAIL_WEBHOOK_URL=http://localhost:3000/api/gmail/webhook

# 6. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
